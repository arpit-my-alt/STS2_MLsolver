"""
Unified static database of "moves" -- the shared schema for both player
cards and enemy AI moves, since structurally they're the same thing: an
actor performs a targeted effect, optionally with a stronger variant.

- Cards: is_upgraded is a real player choice (Bash -> Bash+).
- Enemy moves: is_upgraded represents "the ascension-boosted variant" --
  see ascension_threshold, which cards don't use at all (always None there).

Keyed by (id, is_upgraded). Enemy move ids are namespaced by enemy
(enemy_move_id()) since move NAMES aren't globally unique the way card ids
are -- multiple enemies can independently have a "Slash" or "Bite".

sts2_state.py's EnemyMoveset only stores the TRANSITION GRAPH (which move
follows which, at what probability) -- the moves themselves, and everything
about what a move actually does, lives here instead.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from enum import Enum
import re


class TargetType(Enum):
    NONE = "None"
    SELF = "Self"
    ANY_ENEMY = "AnyEnemy"
    ALL_ENEMIES = "AllEnemies"
    ANY_PLAYER = "AnyPlayer"   # also used for enemy moves targeting the player -- single-player scope, no ambiguity


def to_id(name: str) -> str:
    """'Piercing Gaze' -> 'PIERCING_GAZE'."""
    s = re.sub(r"[^A-Za-z0-9]+", "_", name).strip("_")
    return s.upper()


def enemy_move_id(enemy_base_id: str, move_name: str, occurrence: int = 1) -> str:
    """Namespaces an enemy move id by enemy, e.g. ('INKLET', 'Jab') ->
    'INKLET_JAB'. Always use this rather than bare to_id() for enemy moves
    so different enemies' identically-named moves don't collide in the
    shared MOVES_DB.

    occurrence: some enemies have MULTIPLE table rows sharing the same
    display name but representing mechanically different moves (e.g.
    Ceremonial Beast has two distinct "Beast Cry" rows -- an empty
    stun-trigger stub and a real attack). Pass occurrence=2, 3, ... for the
    2nd+ occurrence of a repeated name within one enemy's move table to get
    a distinct id (e.g. 'CEREMONIAL_BEAST_BEAST_CRY_2'); the 1st occurrence
    keeps the plain, unsuffixed id for backward compatibility."""
    base = f"{to_id(enemy_base_id)}_{to_id(move_name)}"
    return base if occurrence <= 1 else f"{base}_{occurrence}"


@dataclass(frozen=True)
class Move:
    id: str
    is_upgraded: bool = False
    hits: int = 1
    dmg: int = 0
    target: TargetType = TargetType.NONE
    card_type: str | None = None   # "Attack"/"Skill"/"Power"/"Curse"/"Status" for cards; None for enemy moves
    keywords: tuple = ()
    # (op_name, kwargs) pairs -- the shared primitive-op vocabulary the
    # simulator's resolver interprets for BOTH cards and enemy moves.
    effects: tuple = ()
    # Enemy-move-only AI constraint (cap on repeats in a row, e.g. "max 2
    # Jabs in a row"). None for cards, or enemy moves with no such cap.
    max_consecutive: int | None = None
    # Enemy-move-only: after use, this move is ineligible for this many
    # SUBSEQUENT turns regardless of what else is played in between (a
    # stronger constraint than max_consecutive -- e.g. Two-Tailed Rat's
    # Screech has a 3-turn cooldown, not just "can't repeat immediately").
    cooldown_turns: int | None = None
    # Enemy-move-only: this move can be selected at most this many times
    # total in one combat (e.g. Two-Tailed Rat's Call for Backup, once per
    # combat). None = unlimited.
    max_uses_per_combat: int | None = None
    # Enemy-move-only: the ascension at/above which THIS (is_upgraded=True)
    # variant is used instead of the base one. None for cards (whose
    # is_upgraded is a direct player choice, not ascension-gated).
    ascension_threshold: int | None = None
    # Enemy-move-only: dynamic scaling per use THIS COMBAT (e.g. Waterfall
    # Giant's Pressure Gun: starts at base dmg, +5 every subsequent use;
    # Test Subject's Multi-Claw: starts at base hits, +1 every subsequent
    # use). 0 for the overwhelming majority of moves, which don't scale.
    # Use get_enemy_move_scaled() below rather than get_enemy_move() for
    # any move where either of these is nonzero.
    dmg_increment_per_use: int = 0
    hits_increment_per_use: int = 0


