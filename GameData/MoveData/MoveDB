def get_move(move_id: str, is_upgraded: bool = False) -> Move:
    """Card lookup -- pass the real is_upgraded flag straight from the live
    hand (CardInstance.is_upgraded)."""
    if (move_id, is_upgraded) in MOVES_DB:
        return MOVES_DB[(move_id, is_upgraded)]
    return MOVES_DB[(move_id, False)]  # fall back to base tier if only one variant is authored


def get_enemy_move(move_id: str, ascension: int = 0) -> Move:
    """Enemy move lookup -- pass the run's current ascension, NOT
    is_upgraded directly. Resolves whether the ascension-boosted variant
    (ascension_threshold) applies yet."""
    boosted = MOVES_DB.get((move_id, True))
    if boosted is not None and boosted.ascension_threshold is not None and ascension >= boosted.ascension_threshold:
        return boosted
    return MOVES_DB[(move_id, False)]


# ---------------------------------------------------------------------------
# Load scraper-generated move definitions (from merge_movesets.py) on top of
# the hand-authored ones above. Hand-authored entries always win.
# ---------------------------------------------------------------------------

def load_generated_moves(path: str = "enemy_moves_generated.json") -> dict:
    import json as _json
    from pathlib import Path as _Path

    p = _Path(path)
    if not p.exists():
        return {}

    with open(p) as f:
        raw = _json.load(f)

    loaded = {}
    for entry in raw:
        key = (entry["id"], entry["is_upgraded"])
        loaded[key] = Move(
            id=entry["id"],
            is_upgraded=entry["is_upgraded"],
            hits=entry["hits"],
            dmg=entry["dmg"],
            target=TargetType(entry["target"]),
            card_type=entry.get("card_type"),
            keywords=tuple(entry.get("keywords", ())),
            effects=tuple(tuple(e) for e in entry.get("effects", ())),
            max_consecutive=entry.get("max_consecutive"),
            ascension_threshold=entry.get("ascension_threshold"),
        )
    return loaded


for _key, _move in load_generated_moves().items():
    MOVES_DB.setdefault(_key, _move)
